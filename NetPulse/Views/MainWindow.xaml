<Window x:Class="NetPulse.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NetPulse"
        Width="1280"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- Top bar -->
        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left"
                       Text="NetPulse"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,0">
                <Button Content="Scan"
                        Command="{Binding ScanCommand}"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Settings"
                        Command="{Binding ToggleSettingsCommand}" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,16,0">
                <TextBlock Text="{Binding ScanStatusText}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12"
                           Margin="0,0,0,6"/>
                <ProgressBar Height="10"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ScanProgressPercent}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>
        </DockPanel>

        <!-- Device cards area -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Devices"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="2,0,0,10"/>

                <!-- One unified scrollbar for both Online and Offline sections -->
                <ScrollViewer x:Name="DevicesScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">
                    <StackPanel>

                        <!-- Online header -->
                        <TextBlock Text="Online"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="2,2,2,6" />

                        <!-- Online list -->
                        <ListBox ItemsSource="{Binding OnlineDevicesView}"
                                 SelectedItem="{Binding OnlineSelectedDevice, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseRightButtonDown="DevicesList_PreviewMouseRightButtonDown"
                                 PreviewMouseWheel="DevicesList_PreviewMouseWheel">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOnlineDevices}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>

                            <ListBox.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Delete"
                                              Command="{Binding DeleteSelectedDeviceCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="245"
                                            Margin="6"
                                            Padding="12"
                                            CornerRadius="10"
                                            Background="{DynamicResource Surface2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="6"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" LastChildFill="True">
                                                <Ellipse Width="10" Height="10" Margin="0,2,8,0" VerticalAlignment="Top">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource OnlineDotBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                    <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>

                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>

                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding IpAddress, StringFormat=IP: {0}}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="12" />

                                            <TextBlock Grid.Row="4"
                                                       Text="{Binding Vendor}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Online placeholder (same size as device cards) -->
                        <WrapPanel>
                            <WrapPanel.Style>
                                <Style TargetType="WrapPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOnlineDevices}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Style>

                            <Grid Width="245" Height="94" Margin="6">
                                <Border CornerRadius="10"
                                        Background="{DynamicResource Surface2Brush}"
                                        Opacity="0.55" />
                                <Rectangle Stroke="{DynamicResource BorderBrush}"
                                           StrokeThickness="1"
                                           StrokeDashArray="3 3"
                                           RadiusX="10"
                                           RadiusY="10" />
                                <TextBlock Text="No devices are online"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="12"
                                           TextAlignment="Center"/>
                            </Grid>
                        </WrapPanel>

                        <!-- Separator -->
                        <Rectangle Height="1"
                                   Fill="{DynamicResource BorderBrush}"
                                   Margin="2,16,2,12" />

                        <!-- Offline header -->
                        <TextBlock Text="Offline"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="2,0,2,6" />

                        <!-- Offline list -->
                        <ListBox ItemsSource="{Binding OfflineDevicesView}"
                                 SelectedItem="{Binding OfflineSelectedDevice, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseRightButtonDown="DevicesList_PreviewMouseRightButtonDown"
                                 PreviewMouseWheel="DevicesList_PreviewMouseWheel">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOfflineDevices}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>

                            <ListBox.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Delete"
                                              Command="{Binding DeleteSelectedDeviceCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="245"
                                            Margin="6"
                                            Padding="12"
                                            CornerRadius="10"
                                            Background="{DynamicResource Surface2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="6"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" LastChildFill="True">
                                                <Ellipse Width="10" Height="10" Margin="0,2,8,0" VerticalAlignment="Top">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource OnlineDotBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                    <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>

                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>

                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding IpAddress, StringFormat=IP: {0}}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="12" />

                                            <TextBlock Grid.Row="4"
                                                       Text="{Binding Vendor}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Offline placeholder (same size as device cards) -->
                        <WrapPanel>
                            <WrapPanel.Style>
                                <Style TargetType="WrapPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOfflineDevices}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Style>

                            <Grid Width="245" Height="94" Margin="6">
                                <Border CornerRadius="10"
                                        Background="{DynamicResource Surface2Brush}"
                                        Opacity="0.55" />
                                <Rectangle Stroke="{DynamicResource BorderBrush}"
                                           StrokeThickness="1"
                                           StrokeDashArray="3 3"
                                           RadiusX="10"
                                           RadiusY="10" />
                                <TextBlock Text="No devices are offline"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="12"
                                           TextAlignment="Center"/>
                            </Grid>
                        </WrapPanel>

                        <Rectangle Height="8" Fill="Transparent"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Detail sidebar -->
        <Border Grid.Row="2" Grid.Column="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Details"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="2,0,0,10"/>

                <ContentControl Grid.Row="1" Content="{Binding SelectedDevice}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="Select a device to view details."
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Text="Select a device to view details."
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>

                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Hostname}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />

                                <TextBlock Text="{Binding Vendor}"
                                           Margin="0,4,0,16"
                                           Foreground="{DynamicResource MutedTextBrush}" />

                                <TextBlock Text="{Binding IpAddress, StringFormat=IP: {0}}"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="{Binding MacAddress, StringFormat=MAC: {0}}"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="{Binding LastLatencyMs, StringFormat=Latency: {0} ms, TargetNullValue=Latency: n/a}"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="{Binding LastSeen, StringFormat=Last Seen: {0:G}}"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,0,0,16"/>

                                <Border Background="{DynamicResource Surface2Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Latency Graph"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="(placeholder — ping history will appear here in a later iteration)"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- Settings -->
                <Border Grid.Row="2"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,12,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock Text="Settings"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <CheckBox Content="Enable Auto-Prune"
                                  IsChecked="{Binding AutoPruneEnabled, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextBrush}"
                                  Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Auto-prune after"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBox Width="54"
                                     Margin="8,0,8,0"
                                     Text="{Binding AutoPruneDays, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="days offline"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Content="Prune now"
                                Command="{Binding PruneNowCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>