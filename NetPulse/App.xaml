<Application x:Class="NetPulse.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <!-- Core palette -->
        <Color x:Key="AppBackgroundColor">#FF0F1218</Color>
        <Color x:Key="SurfaceColor">#FF151A23</Color>
        <Color x:Key="Surface2Color">#FF1B2230</Color>
        <Color x:Key="AccentColor">#FF2E7DFF</Color>
        <Color x:Key="OnlineDotColor">#FF22C55E</Color>
        <Color x:Key="TextColor">#FFE8EEF7</Color>
        <Color x:Key="MutedTextColor">#FFA8B3C7</Color>
        <Color x:Key="BorderColor">#FF2A3344</Color>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="OnlineDotBrush" Color="{StaticResource OnlineDotColor}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

        <!-- Basic control styling (minimal; will evolve later) -->
        <Style TargetType="{x:Type Window}">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style TargetType="{x:Type ProgressBar}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        </Style>
    </Application.Resources>
</Application>