<Window x:Class="NetPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="NetPulse Wireframe" Height="800" Width="1200"
        Background="#000000">

    <Window.Resources>
        <!-- Lvl Colors (Grayscale Palette) -->
        <SolidColorBrush x:Key="Lvl0Color" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Lvl1Color" Color="#EDEDED"/>
        <SolidColorBrush x:Key="Lvl2Color" Color="#DBDBDB"/>
        <SolidColorBrush x:Key="Lvl3Color" Color="#C9C9C9"/>
        <SolidColorBrush x:Key="Lvl4Color" Color="#B8B8B8"/>
        <SolidColorBrush x:Key="Lvl5Color" Color="#A6A6A6"/>
        <SolidColorBrush x:Key="Lvl6Color" Color="#949494"/>
        <SolidColorBrush x:Key="Lvl7Color" Color="#828282"/>
        <SolidColorBrush x:Key="Lvl8Color" Color="#707070"/>
        <SolidColorBrush x:Key="Lvl9Color" Color="#5E5E5E"/>

        <!-- Universal Gap -->
        <Thickness x:Key="UniversalGap">5</Thickness>
        <Thickness x:Key="UniversalHalfGap">2.5</Thickness>

        <!-- Debug Mode: 0=Off, 1=Hover, 2=Always -->
        <sys:Int32 x:Key="DebugMode">1</sys:Int32>

        <!-- Core Wireframe Item Style -->
        <Style x:Key="WireframeItem" TargetType="ContentControl">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <!-- Outer Border: Transparent hit-test area creating space BETWEEN items -->
                        <Border Background="Transparent"
                                Padding="{StaticResource UniversalHalfGap}">
                            <Grid>
                                <!-- Visual Border (The actual wireframe line) -->
                                <Border BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="1"
                                        Padding="{StaticResource UniversalGap}">
                                    <ContentPresenter/>
                                </Border>

                                <!-- Debug Label -->
                                <Border x:Name="DebugLabel"
                                        HorizontalAlignment="Left" 
                                        VerticalAlignment="Top"
                                        Background="Black"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        Visibility="Collapsed">
                                    <TextBlock Text="{TemplateBinding Tag}" 
                                               Foreground="{TemplateBinding BorderBrush}"
                                               FontSize="10" 
                                               Margin="2"/>
                                </Border>
                            </Grid>
                        </Border>
                        
                        <!-- Debug Logic Triggers -->
                        <ControlTemplate.Triggers>
                            <!-- Mode 1: Hover -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Source={StaticResource DebugMode}}" Value="1"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="DebugLabel" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            
                            <!-- Mode 2: Always -->
                            <DataTrigger Binding="{Binding Source={StaticResource DebugMode}}" Value="2">
                                <Setter TargetName="DebugLabel" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Lvl0: Main Root Container -->
    <ContentControl Style="{StaticResource WireframeItem}"
                    BorderBrush="{StaticResource Lvl0Color}"
                    Tag="mainwindow"
                    x:Name="mainwindow">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Progress -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Lvl1: Header -->
            <ContentControl Grid.Row="0"
                            Style="{StaticResource WireframeItem}"
                            BorderBrush="{StaticResource Lvl1Color}"
                            Tag="mainwindow-header"
                            x:Name="mainwindow_header">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Branding -->
                        <ColumnDefinition Width="*"/>    <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Controls -->
                    </Grid.ColumnDefinitions>

                    <!-- Lvl2: Header Branding -->
                    <ContentControl Grid.Column="0"
                                    Style="{StaticResource WireframeItem}"
                                    BorderBrush="{StaticResource Lvl2Color}"
                                    Tag="mainwindow-header-brand"
                                    x:Name="mainwindow_header_brand">
                        <!-- Lvl3: Title Text -->
                        <ContentControl Style="{StaticResource WireframeItem}"
                                        BorderBrush="{StaticResource Lvl3Color}"
                                        Tag="mainwindow-header-brand-title"
                                        x:Name="mainwindow_header_brand_title"
                                        Width="100"/>
                    </ContentControl>

                    <!-- Lvl2: Header Controls Container -->
                    <ContentControl Grid.Column="2"
                                    Style="{StaticResource WireframeItem}"
                                    BorderBrush="{StaticResource Lvl2Color}"
                                    Tag="mainwindow-header-controls"
                                    x:Name="mainwindow_header_controls">
                        <StackPanel Orientation="Horizontal">
                            <!-- Lvl3: Scan Button -->
                            <ContentControl Style="{StaticResource WireframeItem}"
                                            BorderBrush="{StaticResource Lvl3Color}"
                                            Tag="mainwindow-header-controls-scanbutton"
                                            x:Name="mainwindow_header_controls_scanbutton"
                                            Width="80" Height="30"/>
                            <!-- Lvl3: Settings Button -->
                            <ContentControl Style="{StaticResource WireframeItem}"
                                            BorderBrush="{StaticResource Lvl3Color}"
                                            Tag="mainwindow-header-controls-settingsbutton"
                                            x:Name="mainwindow_header_controls_settingsbutton"
                                            Width="80" Height="30"/>
                        </StackPanel>
                    </ContentControl>
                </Grid>
            </ContentControl>

            <!-- Lvl1: Progress Area -->
            <ContentControl Grid.Row="1"
                            Style="{StaticResource WireframeItem}"
                            BorderBrush="{StaticResource Lvl1Color}"
                            Tag="mainwindow-progress"
                            x:Name="mainwindow_progress">
                <!-- Lvl2: The Bar -->
                <ContentControl Style="{StaticResource WireframeItem}"
                                BorderBrush="{StaticResource Lvl2Color}"
                                Height="20"
                                Tag="mainwindow-progress-bar"
                                x:Name="mainwindow_progress_bar">
                    <!-- Lvl3: Bar Fill -->
                    <ContentControl Style="{StaticResource WireframeItem}"
                                    BorderBrush="{StaticResource Lvl3Color}"
                                    Tag="mainwindow-progress-bar-fill"
                                    x:Name="mainwindow_progress_bar_fill"
                                    HorizontalAlignment="Left"
                                    Width="200"/>
                </ContentControl>
            </ContentControl>

            <!-- Lvl1: Main Content -->
            <ContentControl Grid.Row="2"
                            Style="{StaticResource WireframeItem}"
                            BorderBrush="{StaticResource Lvl1Color}"
                            Tag="mainwindow-content"
                            x:Name="mainwindow_content">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>   <!-- Device Grid -->
                        <ColumnDefinition Width="300"/> <!-- Sidebar -->
                    </Grid.ColumnDefinitions>

                    <!-- Lvl2: Device Grid (Master) -->
                    <ContentControl Grid.Column="0"
                                    Style="{StaticResource WireframeItem}"
                                    BorderBrush="{StaticResource Lvl2Color}"
                                    Tag="mainwindow-content-devicegrid"
                                    x:Name="mainwindow_content_devicegrid">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <WrapPanel>
                                <!-- Lvl3: Device Cards (Examples) -->
                                <ContentControl Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl3Color}" Tag="mainwindow-content-devicegrid-card1" x:Name="mainwindow_content_devicegrid_card1" Width="200" Height="100">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Lvl4: Card Status Indicator -->
                                        <ContentControl Grid.Column="0" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl4Color}" Tag="mainwindow-content-devicegrid-card1-status" x:Name="mainwindow_content_devicegrid_card1_status" Width="10"/>
                                        
                                        <!-- Lvl4: Card Info Area -->
                                        <ContentControl Grid.Column="1" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl4Color}" Tag="mainwindow-content-devicegrid-card1-info" x:Name="mainwindow_content_devicegrid_card1_info">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Lvl5: Vendor Icon -->
                                                <ContentControl Grid.Row="0" Grid.Column="0" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl5Color}" Tag="mainwindow-content-devicegrid-card1-info-icon" x:Name="mainwindow_content_devicegrid_card1_info_icon" Width="30"/>
                                                <!-- Lvl5: Device Name -->
                                                <ContentControl Grid.Row="0" Grid.Column="1" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl5Color}" Tag="mainwindow-content-devicegrid-card1-info-devicename" x:Name="mainwindow_content_devicegrid_card1_info_devicename"/>
                                                <!-- Lvl5: IP Address -->
                                                <ContentControl Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl5Color}" Tag="mainwindow-content-devicegrid-card1-info-ipaddress" x:Name="mainwindow_content_devicegrid_card1_info_ipaddress" Height="25"/>
                                            </Grid>
                                        </ContentControl>
                                    </Grid>
                                </ContentControl>
                                <ContentControl Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl3Color}" Tag="mainwindow-content-devicegrid-card2" x:Name="mainwindow_content_devicegrid_card2" Width="200" Height="100">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Lvl4: Card Status Indicator -->
                                        <ContentControl Grid.Column="0" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl4Color}" Tag="mainwindow-content-devicegrid-card2-status" x:Name="mainwindow_content_devicegrid_card2_status" Width="10"/>

                                        <!-- Lvl4: Card Info Area -->
                                        <ContentControl Grid.Column="1" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl4Color}" Tag="mainwindow-content-devicegrid-card2-info" x:Name="mainwindow_content_devicegrid_card2_info">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Lvl5: Vendor Icon -->
                                                <ContentControl Grid.Row="0" Grid.Column="0" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl5Color}" Tag="mainwindow-content-devicegrid-card2-info-icon" x:Name="mainwindow_content_devicegrid_card2_info_icon" Width="30"/>
                                                <!-- Lvl5: Device Name -->
                                                <ContentControl Grid.Row="0" Grid.Column="1" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl5Color}" Tag="mainwindow-content-devicegrid-card2-info-devicename" x:Name="mainwindow_content_devicegrid_card2_info_devicename"/>
                                                <!-- Lvl5: IP Address -->
                                                <ContentControl Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl5Color}" Tag="mainwindow-content-devicegrid-card2-info-ipaddress" x:Name="mainwindow_content_devicegrid_card2_info_ipaddress" Height="25"/>
                                            </Grid>
                                        </ContentControl>
                                    </Grid>
                                </ContentControl>
                                <ContentControl Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl3Color}" Tag="mainwindow-content-devicegrid-card3" x:Name="mainwindow_content_devicegrid_card3" Width="200" Height="100">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Lvl4: Card Status Indicator -->
                                        <ContentControl Grid.Column="0" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl4Color}" Tag="mainwindow-content-devicegrid-card3-status" x:Name="mainwindow_content_devicegrid_card3_status" Width="10"/>

                                        <!-- Lvl4: Card Info Area -->
                                        <ContentControl Grid.Column="1" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl4Color}" Tag="mainwindow-content-devicegrid-card3-info" x:Name="mainwindow_content_devicegrid_card3_info">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Lvl5: Vendor Icon -->
                                                <ContentControl Grid.Row="0" Grid.Column="0" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl5Color}" Tag="mainwindow-content-devicegrid-card3-info-icon" x:Name="mainwindow_content_devicegrid_card3_info_icon" Width="30"/>
                                                <!-- Lvl5: Device Name -->
                                                <ContentControl Grid.Row="0" Grid.Column="1" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl5Color}" Tag="mainwindow-content-devicegrid-card3-info-devicename" x:Name="mainwindow_content_devicegrid_card3_info_devicename"/>
                                                <!-- Lvl5: IP Address -->
                                                <ContentControl Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl5Color}" Tag="mainwindow-content-devicegrid-card3-info-ipaddress" x:Name="mainwindow_content_devicegrid_card3_info_ipaddress" Height="25"/>
                                            </Grid>
                                        </ContentControl>
                                    </Grid>
                                </ContentControl>
                                <ContentControl Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl3Color}" Tag="mainwindow-content-devicegrid-card4" x:Name="mainwindow_content_devicegrid_card4" Width="200" Height="100">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Lvl4: Card Status Indicator -->
                                        <ContentControl Grid.Column="0" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl4Color}" Tag="mainwindow-content-devicegrid-card4-status" x:Name="mainwindow_content_devicegrid_card4_status" Width="10"/>

                                        <!-- Lvl4: Card Info Area -->
                                        <ContentControl Grid.Column="1" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl4Color}" Tag="mainwindow-content-devicegrid-card4-info" x:Name="mainwindow_content_devicegrid_card4_info">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Lvl5: Vendor Icon -->
                                                <ContentControl Grid.Row="0" Grid.Column="0" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl5Color}" Tag="mainwindow-content-devicegrid-card4-info-icon" x:Name="mainwindow_content_devicegrid_card4_info_icon" Width="30"/>
                                                <!-- Lvl5: Device Name -->
                                                <ContentControl Grid.Row="0" Grid.Column="1" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl5Color}" Tag="mainwindow-content-devicegrid-card4-info-devicename" x:Name="mainwindow_content_devicegrid_card4_info_devicename"/>
                                                <!-- Lvl5: IP Address -->
                                                <ContentControl Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl5Color}" Tag="mainwindow-content-devicegrid-card4-info-ipaddress" x:Name="mainwindow_content_devicegrid_card4_info_ipaddress" Height="25"/>
                                            </Grid>
                                        </ContentControl>
                                    </Grid>
                                </ContentControl>
                            </WrapPanel>
                        </ScrollViewer>
                    </ContentControl>

                    <!-- Lvl2: Detail Sidebar (Detail) -->
                    <ContentControl Grid.Column="1"
                                    Style="{StaticResource WireframeItem}"
                                    BorderBrush="{StaticResource Lvl2Color}"
                                    Tag="mainwindow-content-sidebar"
                                    x:Name="mainwindow_content_sidebar">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- MAC Details -->
                                <RowDefinition Height="*"/>    <!-- Latency Graph -->
                            </Grid.RowDefinitions>

                            <!-- Lvl3: MAC Details Area -->
                            <ContentControl Grid.Row="0"
                                            Style="{StaticResource WireframeItem}"
                                            BorderBrush="{StaticResource Lvl3Color}"
                                            Tag="mainwindow-content-sidebar-details"
                                            x:Name="mainwindow_content_sidebar_details"
                                            Height="150">
                                <StackPanel>
                                    <!-- Lvl4: Detail Placeholders -->
                                    <ContentControl Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl4Color}" Tag="mainwindow-content-sidebar-details-macaddress" x:Name="mainwindow_content_sidebar_details_macaddress" Height="25"/>
                                    <ContentControl Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl4Color}" Tag="mainwindow-content-sidebar-details-hostname" x:Name="mainwindow_content_sidebar_details_hostname" Height="25"/>
                                    <ContentControl Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl4Color}" Tag="mainwindow-content-sidebar-details-vendor" x:Name="mainwindow_content_sidebar_details_vendor" Height="25"/>
                                    <ContentControl Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl4Color}" Tag="mainwindow-content-sidebar-details-lastseen" x:Name="mainwindow_content_sidebar_details_lastseen" Height="25"/>
                                </StackPanel>
                            </ContentControl>

                            <!-- Lvl3: Latency Graph Area -->
                            <ContentControl Grid.Row="1"
                                            Style="{StaticResource WireframeItem}"
                                            BorderBrush="{StaticResource Lvl3Color}"
                                            Tag="mainwindow-content-sidebar-graph"
                                            x:Name="mainwindow_content_sidebar_graph">
                                <!-- Lvl4: Graph Canvas -->
                                <ContentControl Style="{StaticResource WireframeItem}" BorderBrush="{StaticResource Lvl4Color}" Tag="mainwindow-content-sidebar-graph-canvas" x:Name="mainwindow_content_sidebar_graph_canvas"/>
                            </ContentControl>
                        </Grid>
                    </ContentControl>
                </Grid>
            </ContentControl>
        </Grid>
    </ContentControl>
</Window>